{
  "dashboard": {
    "title": "Capacity Planning & Forecasting",
    "tags": ["chat-platform", "capacity"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "1m",
    "panels": [
      {
        "id": 1,
        "title": "User Growth Trend (7 days)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "avg_over_time(online_users_total[7d])",
            "legendFormat": "Average Users",
            "refId": "A"
          },
          {
            "expr": "max_over_time(online_users_total[7d])",
            "legendFormat": "Peak Users",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Users"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Message Volume Trend (7 days)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(messages_sent_total[1h]))",
            "legendFormat": "Messages/sec",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "msg/s", "label": "Messages/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "WebSocket Connection Capacity",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "sum(websocket_connections_total) / 50000 * 100",
            "refId": "A"
          }
        ],
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 90}
              ]
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "id": 4,
        "title": "Database Connection Pool Utilization",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 8},
        "targets": [
          {
            "expr": "sum(db_connections_active) / (sum(db_connections_active) + sum(db_connections_idle)) * 100",
            "refId": "A"
          }
        ],
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 90}
              ]
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "id": 5,
        "title": "CPU Usage by Service",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "rate(process_cpu_seconds_total[5m]) * 100",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "CPU %"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "Memory Usage by Service",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "process_resident_memory_bytes / 1024 / 1024 / 1024",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "decgbytes", "label": "Memory (GB)"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "Network Bandwidth Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "sum(rate(http_response_size_bytes_sum[5m])) by (service) * 8 / 1024 / 1024",
            "legendFormat": "{{service}} egress",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "Mbits", "label": "Bandwidth"},
          {"format": "short"}
        ]
      },
      {
        "id": 8,
        "title": "Storage Growth Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "rate(messages_sent_total[1d]) * 86400 * 500 / 1024 / 1024 / 1024",
            "legendFormat": "Estimated Daily Growth (GB)",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "decgbytes", "label": "Storage (GB/day)"},
          {"format": "short"}
        ]
      },
      {
        "id": 9,
        "title": "Projected Capacity Exhaustion",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "predict_linear(websocket_connections_total[7d], 86400 * 30)",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "Value": "Projected Connections (30 days)"
              }
            }
          }
        ]
      }
    ]
  }
}
